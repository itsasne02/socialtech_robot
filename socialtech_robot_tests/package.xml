<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>socialtech_robot_tests</name>
  <version>0.0.1</version>
  <description>TF contract validation for the SocialTech robot: Xacro/URDF static checks and a read-only runtime TF graph checker (check_tf_contract.py).</description>
  <maintainer email="socialtech@deusto.es">SocialTech Lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>socialtech_robot_description</exec_depend>
  <exec_depend>socialtech_robot_bringup</exec_depend>
  <exec_depend>socialtech_robot_aurora</exec_depend>
  <exec_depend>aurora_depth_obstacle_scan</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
