<?xml version="1.0"?>
<package format="3">
  <name>socialtech_robot_bringup</name>
  <version>0.0.1</version>
  <description>Lightweight real-robot bringup for the SocialTech AgileX Tracer platform.</description>
  <maintainer email="socialtech@deusto.es">SocialTech Lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aurora_depth_obstacle_scan</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>socialtech_robot_aurora</exec_depend>
  <exec_depend>socialtech_robot_description</exec_depend>
  <exec_depend>socialtech_robot_oak</exec_depend>
  <exec_depend>tracer_base</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
